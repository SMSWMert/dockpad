<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DockPad.OneUI7" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_black</item>
        <item name="colorPrimary">@color/samsung_blue</item>
        <item name="colorPrimaryDark">@color/bg_black</item>
        <item name="colorAccent">@color/samsung_blue</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="OneUI7Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="thumbTint">@color/text_primary</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>
</resources>
