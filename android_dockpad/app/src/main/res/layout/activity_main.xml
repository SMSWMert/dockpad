<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/screen_pairing" />
        <include layout="@layout/screen_dashboard" />
        <include layout="@layout/screen_notifications" />
        <include layout="@layout/screen_system_monitor" />
        <include layout="@layout/screen_prompts_vault" />
        <include layout="@layout/screen_standby" />
        <include layout="@layout/screen_settings" />

    </ViewFlipper>
</FrameLayout>
